# Server: copy to .env.backend. Integration secrets for medusa-server, medusa-worker and backup.
# Anything left empty keeps that integration off.

# S3-compatible storage for product images (AWS: leave S3_ENDPOINT empty; R2: set it and S3_ACL=false)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
S3_ENDPOINT=
S3_ACL=
S3_FORCE_PATH_STYLE=false

# Razorpay  (webhook URL: https://<API_DOMAIN>/hooks/payment/razorpay_razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_CAPTURE=true

# PhonePe PG v2  (webhook URL: https://<API_DOMAIN>/hooks/payment/phonepe_phonepe)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=production
PHONEPE_REDIRECT_URL=https://dstore.in/checkout/payment-return
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Google sign-in  (authorized redirect URI in Google Cloud = GOOGLE_CALLBACK_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dstore.in/auth/google/callback

# Resend
RESEND_API_KEY=
RESEND_FROM=D-STORE <orders@dstore.in>
RESEND_REPLY_TO=support@dstore.in
RESEND_SEGMENT_ID=
NEWSLETTER_PROMO_CODE=WELCOME10

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=400050
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=400
SHIPROCKET_AUTO_PICKUP=true

# Off-site database backups (falls back to the S3_* credentials above)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
