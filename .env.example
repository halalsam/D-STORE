# Server: copy to .env next to docker-compose.yml. Read by compose for interpolation.

STORE_DOMAIN=dstore.in
API_DOMAIN=api.dstore.in
ACME_EMAIL=ops@dstore.in

POSTGRES_USER=dstore
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=dstore

# openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
MEILI_MASTER_KEY=change-me-at-least-16-bytes

BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAYS=14

# Pinned by the deploy workflow (<branch>-<sha>). Roll back by editing these.
MEDUSA_TAG=main
FRONTEND_TAG=main
BACKUP_TAG=main
