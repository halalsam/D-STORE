# --- Database / cache (matches docker-compose.yml at repo root) ---
DATABASE_URL=postgres://dstore:dstore@localhost:5432/dstore
REDIS_URL=redis://localhost:6379

# --- CORS ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# --- Secrets (change in production!) ---
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Misc ---
MEDUSA_BACKEND_URL=http://localhost:9000
# shared | server | worker
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
STOREFRONT_URL=http://localhost:8000

# --- Meilisearch (unset = Postgres search) ---
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=dstore_

# --- S3-compatible file storage (unset = local disk) ---
# AWS: leave S3_ENDPOINT empty. R2/MinIO/Spaces: set S3_ENDPOINT, R2 also S3_ACL=false.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
S3_ENDPOINT=
S3_PREFIX=
S3_ACL=
S3_FORCE_PATH_STYLE=false

# --- Razorpay (webhook: <backend>/hooks/payment/razorpay_razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_CAPTURE=true

# --- PhonePe PG v2 (webhook: <backend>/hooks/payment/phonepe_phonepe) ---
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# sandbox | production
PHONEPE_ENV=sandbox
PHONEPE_REDIRECT_URL=http://localhost:8000/checkout/payment-return
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- Google sign-in (redirect URI in Google Cloud = GOOGLE_CALLBACK_URL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# --- Resend (unset = emails are logged, not sent) ---
RESEND_API_KEY=
RESEND_FROM=MotionFit <orders@example.com>
RESEND_REPLY_TO=
# Segment that new subscribers and opted-in customers join
RESEND_SEGMENT_ID=
NEWSLETTER_PROMO_CODE=WELCOME10

# --- Shiprocket ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname from the Shiprocket panel
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=400050
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=400
SHIPROCKET_AUTO_PICKUP=true
