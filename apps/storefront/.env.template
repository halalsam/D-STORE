# Medusa backend URL (server-side). Update CORS in apps/backend/.env if you change ports.
# Leave unset to run in DEMO MODE: bundled sample catalog, cart and account in
# cookies, no backend needed (useful for previews). Set it to go live.
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa admin: Settings -> Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public URL of this storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region (ISO-2, lowercase) when the country can't be detected.
NEXT_PUBLIC_DEFAULT_REGION=in
