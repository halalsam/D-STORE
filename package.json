{
  "name": "d-store",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "backend:dev": "turbo dev --filter=@d-store/backend",
    "backend:migrate": "pnpm --filter @d-store/backend exec medusa db:migrate",
    "backend:user": "pnpm --filter @d-store/backend exec medusa user",
    "backend:seed": "pnpm --filter @d-store/backend run seed",
    "storefront:dev": "turbo dev --filter=@d-store/storefront",
    "backend:seed:dstore": "pnpm --filter @d-store/backend run seed:dstore",
    "backend:setup:integrations": "pnpm --filter @d-store/backend run setup:integrations"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
